# ==============================================================================
# CampusBridge - Environment Variables Template
# Copy this file to .env and fill in the values for local development.
# IMPORTANT: Never commit actual secret keys, passwords, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8 Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusbridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database connection URL used by Spring Boot (read by backend application.properties)
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT (JSON Web Token) Security Settings
# Generate a secure 256-bit secret key for production environments
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_placeholder
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Spring Boot CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Internal AI Service Endpoint accessed by Spring Boot
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal_shared_secret_placeholder

# ------------------------------------------------------------------------------
# 3. Python FastAPI AI Service Configuration
# ------------------------------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development

# External LLM Provider Configuration (e.g., OpenAI, Google Gemini, Anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_external_llm_api_key_placeholder
LLM_MODEL_NAME=gemini-1.5-pro

# Internal Service Authentication Key (must match AI_SERVICE_API_KEY in Backend)
INTERNAL_SERVICE_SECRET=internal_shared_secret_placeholder

# ------------------------------------------------------------------------------
# 4. React Frontend (Vite) Configuration
# Note: Vite requires environment variables exposed to the client to be prefixed with VITE_
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=CampusBridge
VITE_APP_ENV=development
