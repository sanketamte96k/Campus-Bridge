# ==============================================================================
# CampusBridge - Docker Environment Configuration Template
# Copy this file to .env and configure your values before starting containers:
#   cp .env.example .env
# ==============================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
DB_NAME=campusbridge
DB_USERNAME=campusbridge_user
DB_PASSWORD=change-me-db-password

# JWT Authentication
# JWT Secret must be at least 32 characters (256-bit key) for HMAC-SHA256
JWT_SECRET=change-me-to-a-secure-random-jwt-secret-at-least-32-chars-long
JWT_EXPIRATION_MS=86400000

# Application Profile
# "dev" enables DataInitializer seed accounts (Sarah Jenkins, Alex Rivera)
SPRING_PROFILES_ACTIVE=dev

# CORS Configuration (allows Vite local development ports and containerized proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Advisory AI Skill Gap Learning Plan (Google Gemini API)
# Leave LLM_API_KEY blank to gracefully use offline deterministic template plans
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_TIMEOUT_MS=15000
