# ==============================================================================
# CampusBridge - Root .gitignore
# Excludes compiled binaries, dependencies, environment secrets, and build artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Environment Variables & Secret Keys
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.jks
*.keystore

# ------------------------------------------------------------------------------
# IDE and Editor Configurations
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/load-impl.xml

# ------------------------------------------------------------------------------
# Java & Maven (Backend)
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Node.js, React & Vite (Frontend)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Python & FastAPI (AI Service)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
develop-eggs/
eggs/
parts/
var/
sdist/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
tmp/

# ------------------------------------------------------------------------------
# Database & Local Stores
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
